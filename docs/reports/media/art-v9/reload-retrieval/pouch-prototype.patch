 ## ports, and a glow disc at the muzzle. Vertex colour is the hue and alpha the additive
 ## weight, fading to nothing at every outer edge, so there is no hard silhouette to read as a
 ## sticker. 213 triangles; shared by every build.
+## A magazine pouch for the reload's pickup, in the magazine's own space (the magazine hangs from its origin along -Y, the feed end at
+## the origin): a shallow shell round the feed end, open toward the baseplate (the hand takes the magazine by its base), with a
+## rim, a webbing strap and a flap folded back. About 90 triangles.
+static func pouch_mesh(bounds: AABB) -> ArrayMesh:
+	var shell := Color(0.050, 0.056, 0.064)
+	var rim := Color(0.085, 0.092, 0.100)
+	var strap := Color(0.115, 0.120, 0.100)
+	var margin := 0.006
+	var x0 := bounds.position.x - margin
+	var x1 := bounds.end.x + margin
+	var z0 := bounds.position.z - margin
+	var z1 := bounds.end.z + margin
+	var y_top := 0.010
+	var y_mouth := -0.078
+	var flare := 0.003   # the mouth is a little wider than the closed end
+	var tool := SurfaceTool.new()
+	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
+	var quad := func(a: Vector3, b: Vector3, c: Vector3, d: Vector3, colour: Color) -> void:
+		for v: Vector3 in [a, b, c, a, c, d]:
+			tool.set_color(colour)
+			tool.add_vertex(v)
+	# outer shell: closed end and four sides (counter-clockwise seen from outside)
+	var a0 := Vector3(x0, y_top, z0)
+	var a1 := Vector3(x1, y_top, z0)
+	var a2 := Vector3(x1, y_top, z1)
+	var a3 := Vector3(x0, y_top, z1)
+	var b0 := Vector3(x0 - flare, y_mouth, z0 - flare)
+	var b1 := Vector3(x1 + flare, y_mouth, z0 - flare)
+	var b2 := Vector3(x1 + flare, y_mouth, z1 + flare)
+	var b3 := Vector3(x0 - flare, y_mouth, z1 + flare)
+	quad.call(a3, a2, a1, a0, shell)           # the closed end (faces +Y)
+	quad.call(a0, a1, b1, b0, shell)           # -Z side
+	quad.call(a1, a2, b2, b1, shell)           # +X side
+	quad.call(a2, a3, b3, b2, shell)           # +Z side
+	quad.call(a3, a0, b0, b3, shell)           # -X side
+	# inner faces (the shell is seen from inside where the magazine leaves it), inset by the wall
+	var wall := 0.0025
+	var c0 := Vector3(x0 + wall, y_top - wall, z0 + wall)
+	var c1 := Vector3(x1 - wall, y_top - wall, z0 + wall)
+	var c2 := Vector3(x1 - wall, y_top - wall, z1 - wall)
+	var c3 := Vector3(x0 + wall, y_top - wall, z1 - wall)
+	var d0 := Vector3(x0 - flare + wall, y_mouth, z0 - flare + wall)
+	var d1 := Vector3(x1 + flare - wall, y_mouth, z0 - flare + wall)
+	var d2 := Vector3(x1 + flare - wall, y_mouth, z1 + flare - wall)
+	var d3 := Vector3(x0 - flare + wall, y_mouth, z1 + flare - wall)
+	quad.call(c0, c1, c2, c3, shell.darkened(0.4))
+	quad.call(d0, c0, c3, d3, shell.darkened(0.4))
+	quad.call(d1, d0, c0, c1, shell.darkened(0.4))
+	quad.call(d2, d1, c1, c2, shell.darkened(0.4))
+	quad.call(d3, d2, c2, c3, shell.darkened(0.4))
+	# the mouth's rim: the wall's thickness, lighter, so the opening reads
+	quad.call(b0, b1, d1, d0, rim)
+	quad.call(b1, b2, d2, d1, rim)
+	quad.call(b2, b3, d3, d2, rim)
+	quad.call(b3, b0, d0, d3, rim)
+	# a webbing strap round the shell near the mouth (a raised band) and its tab on the +Z face
+	var ys := y_mouth + 0.016
+	var yt := y_mouth + 0.026
+	var lift := 0.0016
+	var f := func(y: float) -> float: return flare * (y - y_top) / (y_mouth - y_top)
+	var s0 := Vector3(x0 - f.call(ys) - lift, ys, z0 - f.call(ys) - lift)
+	var s1 := Vector3(x1 + f.call(ys) + lift, ys, z0 - f.call(ys) - lift)
+	var s2 := Vector3(x1 + f.call(ys) + lift, ys, z1 + f.call(ys) + lift)
+	var s3 := Vector3(x0 - f.call(ys) - lift, ys, z1 + f.call(ys) + lift)
+	var t0 := Vector3(x0 - f.call(yt) - lift, yt, z0 - f.call(yt) - lift)
+	var t1 := Vector3(x1 + f.call(yt) + lift, yt, z0 - f.call(yt) - lift)
+	var t2 := Vector3(x1 + f.call(yt) + lift, yt, z1 + f.call(yt) + lift)
+	var t3 := Vector3(x0 - f.call(yt) - lift, yt, z1 + f.call(yt) + lift)
+	quad.call(s0, s1, t1, t0, strap)
+	quad.call(s1, s2, t2, t1, strap)
+	quad.call(s2, s3, t3, t2, strap)
+	quad.call(s3, s0, t0, t3, strap)
+	# the flap, folded back from the closed end over the +Z face and hanging open: a short tapering tongue
+	var fy := y_top - 0.002
+	var fz := z1 + 0.003
+	quad.call(Vector3(x0 + 0.004, fy, fz), Vector3(x1 - 0.004, fy, fz), Vector3(x1 - 0.008, fy - 0.030, fz + 0.011), Vector3(x0 + 0.008, fy - 0.030, fz + 0.011), strap.darkened(0.2))
+	quad.call(Vector3(x0 + 0.008, fy - 0.030, fz + 0.011), Vector3(x1 - 0.008, fy - 0.030, fz + 0.011), Vector3(x1 - 0.004, fy, fz), Vector3(x0 + 0.004, fy, fz), strap.darkened(0.45))
+	tool.generate_normals()
+	return tool.commit()
+
