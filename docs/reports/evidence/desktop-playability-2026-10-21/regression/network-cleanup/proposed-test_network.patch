--- a/scripts/test_network.sh
+++ b/scripts/test_network.sh
@@ -5,12 +5,51 @@
 SERVER_PID=''
 CLIENT_A=''
 CLIENT_B=''
+# Only unreaped direct children are retained in these variables. Background
+# jobs may finish before cleanup; never signal a PID absent from our running jobs.
+is_running_child() {
+  local wanted="$1" child
+  for child in $(jobs -pr); do
+    if [[ "$child" == "$wanted" ]]; then return 0; fi
+  done
+  return 1
+}
 cleanup() {
+  local original_status=$? pid child_status running deadline
+  trap - EXIT
+  trap '' INT TERM
+  set +e
   for pid in "$SERVER_PID" "$CLIENT_A" "$CLIENT_B"; do
-    if [[ -n "$pid" ]]; then kill "$pid" 2>/dev/null || true; fi
+    if [[ -n "$pid" ]] && is_running_child "$pid"; then
+      kill -TERM "$pid" 2>/dev/null
+    fi
   done
+  deadline=$((SECONDS + 5))
+  while (( SECONDS < deadline )); do
+    running=false
+    for pid in "$SERVER_PID" "$CLIENT_A" "$CLIENT_B"; do
+      if [[ -n "$pid" ]] && is_running_child "$pid"; then running=true; fi
+    done
+    if [[ "$running" == false ]]; then break; fi
+    sleep 0.1
+  done
+  for pid in "$SERVER_PID" "$CLIENT_A" "$CLIENT_B"; do
+    if [[ -z "$pid" ]]; then continue; fi
+    if is_running_child "$pid"; then
+      kill -KILL "$pid" 2>/dev/null
+      printf 'NETWORK_CLEANUP pid=%s escalation=SIGKILL\n' "$pid" >>"$LOG_DIR/cleanup.log"
+    fi
+    child_status=0
+    wait "$pid" 2>/dev/null || child_status=$?
+    printf 'NETWORK_CLEANUP pid=%s wait_exit=%s\n' "$pid" "$child_status" >>"$LOG_DIR/cleanup.log"
+  done
+  printf 'NETWORK_LOG_DIR=%s\n' "$LOG_DIR"
+  if [[ -f "$LOG_DIR/cleanup.log" ]]; then cat "$LOG_DIR/cleanup.log"; fi
+  exit "$original_status"
 }
 trap cleanup EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
 ./scripts/godot.sh --headless --script res://tests/network_probe.gd -- --server >"$LOG_DIR/server.log" 2>&1 &
 SERVER_PID=$!
 for attempt in $(seq 1 80); do
@@ -24,7 +63,9 @@
 CLIENT_B=$!
 RESULT=0
 wait "$CLIENT_A" || RESULT=1
+CLIENT_A=''
 wait "$CLIENT_B" || RESULT=1
+CLIENT_B=''
 cat "$LOG_DIR/server.log" "$LOG_DIR/client-a.log" "$LOG_DIR/client-b.log"
 if ! rg -q NETWORK_CLIENT_PASS "$LOG_DIR/client-a.log" || ! rg -q NETWORK_CLIENT_PASS "$LOG_DIR/client-b.log"; then RESULT=1; fi
 if rg -q '^ERROR:|SCRIPT ERROR|Parse Error' "$LOG_DIR"; then RESULT=1; fi
