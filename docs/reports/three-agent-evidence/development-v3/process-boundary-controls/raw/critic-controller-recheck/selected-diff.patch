+def ocr_text(command, image, deadline, output):
+    """Bound OCR by the remaining flow deadline and retain partial failed output."""
+    remaining = deadline - time.monotonic()
+    if remaining <= 0:
+        raise TimeoutError('Offline OCR deadline expired before launch')
+    process = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                               stderr=subprocess.PIPE, **process_group_options())
+    error, stdout, stderr = None, b'', b''
+    try:
+        stdout, stderr = process.communicate(image, timeout=min(15, remaining))
+        if process.returncode != 0:
+            error = RuntimeError('Offline OCR exited ' + str(process.returncode))
+    except subprocess.TimeoutExpired:
+        error = TimeoutError('Offline OCR exceeded its remaining wall-clock budget')
+    finally:
+        try:
+            terminate_process_tree(process)
+        finally:
+            if error is not None:
+                stdout, stderr = process.communicate()
+            output.with_suffix('.stdout.txt').write_bytes(stdout)
+            output.with_suffix('.stderr.txt').write_bytes(stderr)
+    if error is not None:
+        raise error
+    return stdout.decode('utf-8', errors='replace')
 
 
