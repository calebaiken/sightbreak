# Godot rewrites import/config files with LF. Keep native Windows imports clean.
game/**/*.gd text eol=lf
game/**/*.gdshader text eol=lf
game/**/*.uid text eol=lf
game/**/*.import text eol=lf
game/**/*.tscn text eol=lf
game/**/*.tres text eol=lf
game/**/*.svg text eol=lf
game/*.godot text eol=lf
game/*.cfg text eol=lf
scripts/*.py text eol=lf
scripts/*.sh text eol=lf
.github/workflows/*.yml text eol=lf
